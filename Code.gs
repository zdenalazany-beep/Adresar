const SHEET_NAME="Adresář";const DRIVE_FOLDER_NAME="Adresář fotografie";const HEADERS=["ID","Jméno","Příjmení","Telefon","Telefon 2","E-mail","Kód","PSČ","Město","Adresa","Fotografie","Poznámka"];function setup(){const s=SpreadsheetApp.getActiveSpreadsheet();let h=s.getSheetByName(SHEET_NAME);if(!h)h=s.insertSheet(SHEET_NAME);if(h.getLastRow()===0)h.appendRow(HEADERS);return h}function doGet(e){setup();return json(e.parameter.action==="list"?list():{ok:true})}function doPost(e){try{const p=JSON.parse(e.postData.contents||"{}"),h=setup();if(p.action==="create")return json({ok:true,id:create(h,p)});if(p.action==="update")return json({ok:true,id:update(h,p)});if(p.action==="delete")return json({ok:true,id:remove(h,p.id)});return json({ok:false,error:"Neznámá akce"})}catch(x){return json({ok:false,error:String(x)})}}function list(){let v=setup().getDataRange().getValues();return v.length<2?[]:v.slice(1).filter(r=>r[0]).map(r=>({id:r[0],name:r[1],surname:r[2],phone:r[3],phone2:r[4],email:r[5],code:r[6],zip:r[7],city:r[8],address:r[9],photo:r[10],note:r[11]}))}function folder(){let i=DriveApp.getFoldersByName(DRIVE_FOLDER_NAME);return i.hasNext()?i.next():DriveApp.createFolder(DRIVE_FOLDER_NAME)}function upload(p){if(!p.photoData)return"";let b=Utilities.base64Decode(p.photoData),f=folder().createFile(Utilities.newBlob(b,p.photoType||"image/jpeg",p.photoName||"foto.jpg"));f.setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);return f.getUrl()}function create(h,p){let id=Utilities.getUuid();h.appendRow([id,p.name||"",p.surname||"",p.phone||"",p.phone2||"",p.email||"",p.code||"",p.zip||"",p.city||"",p.address||"",upload(p),p.note||""]);return id}function update(h,p){let v=h.getDataRange().getValues(),i=v.findIndex((r,n)=>n>0&&String(r[0])===String(p.id));if(i<1)throw Error("Kontakt nenalezen");let url=p.photoData?upload(p):v[i][10];h.getRange(i+1,1,1,HEADERS.length).setValues([[p.id,p.name||"",p.surname||"",p.phone||"",p.phone2||"",p.email||"",p.code||"",p.zip||"",p.city||"",p.address||"",url,p.note||""]]);return p.id}function remove(h,id){let v=h.getDataRange().getValues(),i=v.findIndex((r,n)=>n>0&&String(r[0])===String(id));if(i<1)throw Error("Kontakt nenalezen");h.deleteRow(i+1);return id}function json(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON)}